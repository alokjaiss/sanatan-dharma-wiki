# Names only. Real values live in Vercel project settings and GitHub Actions secrets, never in git.

# Site (Phase 1)
SITE_URL=https://your-production-url        # canonical URLs and sitemap
SITE_LAUNCHED=                              # leave empty; set true only for local SEO checks

# Supabase (Phase 2: corrections, reviewer accounts)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=                   # publishable key; row-level security protects tables
SUPABASE_SERVICE_ROLE_KEY=                  # server-only (Vercel functions); never exposed to the browser

# Cloudflare (Phase 2: media on R2, Turnstile on forms)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sanatan-dharma-wiki-media
PUBLIC_R2_BASE_URL=                         # public custom domain for the bucket
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
