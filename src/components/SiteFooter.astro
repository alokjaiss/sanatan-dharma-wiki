---
import { site } from '../config/site';
import { t } from '../i18n';

const links = [
  { href: '/about/', label: t('footer.about') },
  { href: '/how-this-is-written/', label: t('footer.method') },
  { href: '/editorial-policy/', label: t('footer.policy') },
  { href: '/transliteration/', label: t('footer.transliteration') },
  { href: '/sources/', label: t('footer.sources') },
  { href: '/contribute/', label: t('footer.contribute') },
];
---

<footer class="site-footer">
  <div class="double-rule"></div>
  <div class="container inner">
    <div class="colophon">
      <p class="name">{site.name}</p>
      <p class="native" lang="sa-Deva">{site.nativeName}</p>
      <p class="licence">
        <Fragment
          set:html={t('site.licence', {
            licence: `<a href="${site.license.url}" rel="license">${site.license.name}</a>`,
          })}
        />
      </p>
      <p><a href={site.repo.url}>{t('site.sourceCode')}</a></p>
    </div>
    <nav aria-label={t('site.footerNav')}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem 3rem;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .colophon p {
    margin: 0 0 0.35rem;
    max-width: 30rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .native {
    color: var(--ink-faint);
  }

  .licence {
    margin-top: 0.9rem !important;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2.5rem;
  }

  li {
    margin-bottom: 0.45rem;
  }

  nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }
</style>
