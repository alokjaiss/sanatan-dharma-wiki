---
import { t } from '../i18n';
import { label, referenceLead, type ReferenceData } from '../lib/format';

interface Props {
  references: ReferenceData[];
}

const { references } = Astro.props;
// Pieces around the title are joined as plain strings so no template whitespace leaks
// between them ("Title . Publisher").
const items = references.map((ref) => {
  const lead = referenceLead(ref);
  const after = [ref.publisher, ref.locator].filter(Boolean).join(', ');
  return { ref, before: lead ? `${lead}. ` : '', after: after ? `. ${after}.` : '.' };
});
---

{
  items.length > 0 && (
    <section class="references" aria-labelledby="references-title" data-pagefind-ignore>
      <h2 id="references-title">{t('entry.references')}</h2>
      <ol>
        {items.map(({ ref, before, after }) => (
          <li>
            <span class="kind">{label('referenceKind', ref.kind)}</span>
            {/* Kept on one line: whitespace between these parts would show before the full stop. */}
            <span class="citation">{before}{ref.url ? <a href={ref.url} rel="noopener"><cite>{ref.title}</cite></a> : <cite>{ref.title}</cite>}{after}{ref.note && <span class="note"> {ref.note}</span>}</span>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .references {
    margin-top: 3rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 560;
    margin: 0 0 0.9rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: ref;
    font-size: 0.9rem;
  }

  li {
    counter-increment: ref;
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 0.25rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--rule);
  }

  li::before {
    content: counter(ref);
    grid-row: span 2;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-faint);
    padding-top: 0.15rem;
  }

  .kind {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  cite {
    font-style: italic;
  }

  .note {
    color: var(--ink-soft);
  }
</style>
